          }
        ]
      },
      {
        "language": "id",
        "groups": [
          {
            "group": "Memulai",
            "pages": [
              "id/index",
              "id/quickstart"
            ]
          },
          {
            "group": "Memulai dengan Fisika",
            "icon": "atom",
            "pages": [
              "id/physics/welcome",
              "id/physics/what-is-physics",
              "id/physics/motion",
              "id/physics/forces",
              "id/physics/energy",
              "id/physics/momentum",
              "id/physics/gravity",
              "id/physics/pressure-and-fluids",
              "id/physics/heat-and-temperature",
              "id/physics/waves-and-sound",
              "id/physics/electricity-and-magnetism",
              "id/physics/problem-solving"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
